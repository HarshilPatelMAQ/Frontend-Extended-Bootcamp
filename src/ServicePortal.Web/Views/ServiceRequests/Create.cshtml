@model ServicePortal.Web.ViewModels.CreateServiceRequestViewModel
@using ServicePortal.Domain.Enums

@{
    ViewData["Title"] = "Create Service Request";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-link p-0 text-decoration-none text-muted mb-2">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
                <h1 class="h3 font-weight-bold mb-1"><i class="bi bi-plus-circle me-2 text-primary"></i>Create New Service Request</h1>
                <p class="text-muted">Fill out the details below to submit a ticket to the appropriate support team.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label font-weight-bold">Request Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="e.g. Laptop display flickering after reboot" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label font-weight-bold">Category <span class="text-danger">*</span></label>
                                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label font-weight-bold">Priority <span class="text-danger">*</span></label>
                                <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<RequestPriority>()">
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PreferredContactMethod" class="form-label font-weight-bold">Preferred Contact Method</label>
                            <select asp-for="PreferredContactMethod" class="form-select">
                                <option value="Email">Email</option>
                                <option value="Teams">Microsoft Teams</option>
                                <option value="Phone">Phone</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label font-weight-bold">Description & Details <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Provide a detailed description of the issue, error messages, or steps to reproduce..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-light border">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-send-fill me-1"></i> Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
