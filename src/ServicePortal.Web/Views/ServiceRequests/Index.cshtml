@model ServicePortal.Web.ViewModels.ServiceRequestListViewModel
@using ServicePortal.Domain.Enums

@{
    ViewData["Title"] = "Service Desk Dashboard";
}

<div class="container-fluid py-4">
    <!-- Header Banner -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 font-weight-bold mb-1 text-dark"><i class="bi bi-speedometer2 me-2 text-primary"></i>Service Management Dashboard</h1>
            <p class="text-muted mb-0">Track, manage, resolve, and audit enterprise service requests.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportCsv"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-statusFilter="@Model.StatusFilter"
               asp-route-priorityFilter="@Model.PriorityFilter"
               asp-route-categoryFilter="@Model.CategoryFilter"
               asp-route-ownershipFilter="@Model.OwnershipFilter"
               class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-download me-1"></i> Export CSV
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Service Request
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- High-Contrast KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-primary shadow-sm rounded-3 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold mb-1">Total Tickets</div>
                        <div class="h2 font-weight-bold text-dark mb-0">@ViewBag.TotalCount</div>
                    </div>
                    <div class="fs-1 text-primary opacity-75"><i class="bi bi-ticket-detailed-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-warning shadow-sm rounded-3 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold mb-1">Active / Open</div>
                        <div class="h2 font-weight-bold text-dark mb-0">@ViewBag.OpenCount</div>
                    </div>
                    <div class="fs-1 text-warning opacity-75"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-danger shadow-sm rounded-3 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold mb-1">SLA Breached</div>
                        <div class="h2 font-weight-bold text-danger mb-0">@ViewBag.BreachedCount</div>
                    </div>
                    <div class="fs-1 text-danger opacity-75"><i class="bi bi-exclamation-octagon-fill"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 border-start border-4 border-success shadow-sm rounded-3 bg-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold mb-1">Resolved</div>
                        <div class="h2 font-weight-bold text-success mb-0">@ViewBag.ResolvedCount</div>
                    </div>
                    <div class="fs-1 text-success opacity-75"><i class="bi bi-check-circle-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-start-0" placeholder="Search reference, title..." value="@Model.SearchTerm" />
                    </div>
                </div>
                <div class="col-md-2">
                    <select name="statusFilter" class="form-select" asp-items="Html.GetEnumSelectList<RequestStatus>()">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="priorityFilter" class="form-select" asp-items="Html.GetEnumSelectList<RequestPriority>()">
                        <option value="">-- All Priorities --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="categoryFilter" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">-- All Categories --</option>
                    </select>
                </div>
                @if (ViewBag.IsStaff == true)
                {
                    <div class="col-md-2">
                        <select name="ownershipFilter" class="form-select">
                            <option value="all" selected="@(Model.OwnershipFilter == "all")">All Tickets</option>
                            <option value="mine" selected="@(Model.OwnershipFilter == "mine")">Assigned to Me</option>
                        </select>
                    </div>
                }
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-dark"><i class="bi bi-funnel-fill me-1"></i>Filter</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tickets Table -->
    <div class="card border-0 shadow-sm rounded-3 bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Reference</th>
                            <th>Title & Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Requester</th>
                            <th>Assignee</th>
                            <th>SLA Status</th>
                            <th>Created Date</th>
                            <th class="pe-4 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Requests.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No service requests found matching the current filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Requests)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                            @item.ReferenceNumber
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.Title</div>
                                        <small class="text-muted"><i class="bi bi-tag me-1"></i>@item.CategoryName</small>
                                    </td>
                                    <td>
                                        @switch (item.Priority)
                                        {
                                            case RequestPriority.Critical:
                                                <span class="badge bg-danger text-white"><i class="bi bi-exclamation-octagon-fill me-1"></i>Critical</span>
                                                break;
                                            case RequestPriority.High:
                                                <span class="badge bg-warning text-dark"><i class="bi bi-arrow-up-circle-fill me-1"></i>High</span>
                                                break;
                                            case RequestPriority.Medium:
                                                <span class="badge bg-info text-dark"><i class="bi bi-dash-circle-fill me-1"></i>Medium</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary text-white"><i class="bi bi-arrow-down-circle-fill me-1"></i>Low</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case RequestStatus.New:
                                                <span class="badge bg-primary">New</span>
                                                break;
                                            case RequestStatus.InProgress:
                                                <span class="badge bg-info text-dark">In Progress</span>
                                                break;
                                            case RequestStatus.WaitingForRequester:
                                                <span class="badge bg-warning text-dark">Waiting For Requester</span>
                                                break;
                                            case RequestStatus.Resolved:
                                                <span class="badge bg-success">Resolved</span>
                                                break;
                                            case RequestStatus.Closed:
                                                <span class="badge bg-dark">Closed</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td><small class="fw-medium text-dark">@item.RequesterName</small></td>
                                    <td><small class="text-muted">@(item.AssigneeName ?? "Unassigned")</small></td>
                                    <td>
                                        @if (item.IsResponseSlaBreached || item.IsResolutionSlaBreached)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-alarm-fill me-1"></i>SLA Breached</span>
                                        }
                                        else if (item.Status == RequestStatus.Resolved || item.Status == RequestStatus.Closed)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-all me-1"></i>SLA Met</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success"><i class="bi bi-clock me-1"></i>On Track</span>
                                        }
                                    </td>
                                    <td><small class="text-muted">@item.CreatedDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                    <td class="pe-4 text-end">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            View <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-light d-flex justify-content-between align-items-center p-3">
                <small class="text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (@Model.TotalItems total requests)</small>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-searchTerm="@Model.SearchTerm">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-searchTerm="@Model.SearchTerm">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-searchTerm="@Model.SearchTerm">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
